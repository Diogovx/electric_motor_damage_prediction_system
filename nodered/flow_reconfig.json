  {"id":"fn_auto","type":"function","z":"tab_tcc","name":"alternar A/B (max. 30)","func":"const LIMITE = 30;\nconst A = '/home/diogo/Documentos/PlatformIO/Projects/tcc_monitoramento2/data/test_a.json';\nconst B = '/home/diogo/Documentos/PlatformIO/Projects/tcc_monitoramento2/data/test_b.json';\nconst n = flow.get('auto') || 0;\nif (n >= LIMITE) {\n  node.status({fill:'yellow', shape:'ring', text:'fim dos ensaios'});\n  return null;\n}\nflow.set('auto', n + 1);\nconst usarA = (n % 2) === 1;\nmsg.filename = usarA ? A : B;\nmsg.tag = usarA ? 'A' : 'B';\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":220,"wires":[["file_in"]]},
  {"id":"file_in","type":"file in","z":"tab_tcc","name":"ler payload","filename":"filename","filenameType":"msg","format":"utf8","chunk":false,"sendError":true,"encoding":"none","allProps":false,"x":400,"y":110,"wires":[["fn_trial"]]},
  {"id":"fn_trial","type":"function","z":"tab_tcc","name":"numerar ensaio","func":"const n = (flow.get('trial') || 0) + 1;\nflow.set('trial', n);\nconst p = JSON.parse(msg.payload);\np.trial = n;\np.tag = msg.tag || p.tag || '';\nmsg.payload = JSON.stringify(p);\nnode.status({text: 'ensaio ' + n + ' (' + p.tag + ')'});\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":610,"y":110,"wires":[["out_cmd"]]},
