  {"id":"dbg_status","type":"debug","z":"tab_tcc","name":"status do ESP32","active":true,"tosidebar":true,"console":false,"tostatus":true,"complete":"payload","targetType":"msg","statusVal":"payload.state","statusType":"auto","x":360,"y":300,"wires":[]},
  {"id":"fn_csv","type":"function","z":"tab_tcc","name":"summary -> CSV","func":"const p = msg.payload;\nif (msg.retain || !p || p.state !== 'summary') return null;\nmsg.payload = [p.trial, p.tag, p.version, p.transfer_ms, p.persist_ms, p.switch_ms, p.refill_ms, p.reconf_ms, p.gap_ms].join(',');\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":350,"y":360,"wires":[["out_csv"]]},
